# Copy to .env (gitignored) and fill in. Only needed for LIVE runs
# (corpus collection, retrieval, judging). Offline reproduction of the
# released metrics and report needs no keys at all.

# NASA ADS — corpus rebuild (scripts/prepare_corpus.py)
# https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=

# OpenAI — embeddings (retrieval) and outcome judging
OPENAI_API_KEY=
